# Copy to .env.local for local development. On Railway, set these as service variables.
# Never commit real values.

# Railway Postgres: reference the database's variable, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@localhost:5432/picks

# The one account. No sign-up page exists.
AUTH_EMAIL=you@example.com
# Output of: npm run hash-password
AUTH_PASSWORD_HASH=
# 32+ random characters, e.g. output of: openssl rand -base64 48
AUTH_SECRET=

# Shared secret the Railway cron services send as "Authorization: Bearer <CRON_SECRET>" (32+ chars)
CRON_SECRET=

# Data APIs (milestone 3)
ODDS_API_KEY=
CFBD_API_KEY=
